{
  "name": "migration-v2-ui",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@contentstack/json-rte-serializer": "^3.1.0",
    "@contentstack/venus-components": "^3.0.5",
    "@reduxjs/toolkit": "^2.8.2",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.2.13",
    "@types/react-redux": "^7.1.33",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "axios": "^1.16.0",
    "final-form": "^4.20.10",
    "html-react-parser": "^4.2.9",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-final-form": "^6.5.9",
    "react-redux": "^9.1.2",
    "react-router": "^7.15.0",
    "react-router-dom": "^7.15.0",
    "react-toastify": "npm:@contentstack/react-toastify@6.1.5",
    "redux-persist": "^6.0.0",
    "sass": "^1.68.0",
    "socket.io-client": "^4.7.5",
    "typescript": "^4.9.5",
    "uuid": "^14.0.0",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prettify": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx . --ignore-pattern './node_modules/' --ignore-pattern './build/' --ignore-pattern '.eslintrc.js'",
    "precommit": "npm run prettify && npm run lint:fix",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "vitest run --coverage && open coverage/index.html",
    "coverage:ui": "npx serve coverage -l 3939"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "4.1.2",
    "@vitest/ui": "4.1.2",
    "eslint": "^8.51.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.3.3",
    "vitest": "4.1.2"
  },
  "overrides": {
    "@babel/runtime": ">=7.26.10",
    "immutable": ">=5.1.5",
    "lodash-es": "^4.18.1",
    "minimatch": ">=10.2.3",
    "rollup": ">=4.59.0",
    "lodash": "^4.18.1",
    "dompurify": ">=3.4.11",
    "form-data": ">=4.0.6",
    "ws": ">=8.21.0",
    "esbuild": "^0.28.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:react/recommended",
      "plugin:react-hooks/recommended"
    ],
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }
}
