    "immutable": ">=5.1.5",
    "lodash-es": ">=4.17.23",
    "minimatch": ">=9.0.7",
    "rollup": "^4.59.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:react/recommended",
      "plugin:react-hooks/recommended"
