{
  "name": "migration-upload",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "for d in migration-*; do [ -f \"$d/package.json\" ] && npm --prefix $d run build; done && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:ui": "npx serve coverage -l 3939",
    "hydrate-config": "ts-node --transpile-only -r dotenv/config scripts/hydrate-config.ts",
    "start": "npm run build && tsc && npm run hydrate-config && node build/index.js",
    "startNew": "tsc && npm run hydrate-config && node build/index.js",
    "validation": "tsc && node build/main.js",
    "prettify": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx . --ignore-pattern './node_modules/' --ignore-pattern './buid/' --ignore-pattern '.eslintrc.js'",
    "precommit": "npm run prettify && npm run lint:fix",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/lodash.isempty": "^4.4.9",
    "@types/mkdirp": "^1.0.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/wordpress__block-library": "^2.6.3",
    "@types/wordpress__blocks": "^12.5.18",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
