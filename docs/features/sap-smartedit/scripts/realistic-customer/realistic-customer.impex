# =============================================================================
# Nimbus Electronics — realistic SAP SmartEdit export for end-to-end validation.
# Not a stress test: every reference/asset here is meant to resolve correctly,
# the way most of a real customer's catalog does. The handful of imperfections
# (a page mid-translation, an orphaned banner reference, two untranslated legal
# pages) are the kind real content teams actually leave behind, not labeled test
# rows. Backing images live in images/ (generated by gen_assets.py).
# =============================================================================

$catalogId = nimbusContentCatalog
$contentCV = catalogVersion(CatalogVersion.catalog(Catalog.id[default=$catalogId]),CatalogVersion.version[default=Online])[default=$catalogId:Online]

