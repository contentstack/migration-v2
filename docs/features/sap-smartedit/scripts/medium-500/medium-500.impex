# =============================================================================
# MEDIUM-500 — every edge case from edge-cases.impex (embedded below, byte-for-
# byte unchanged) plus ~470 additional "normal" filler rows in the SAME
# proportions as the 10,000-row load-test dataset, generated by
# generate-medium-500-impex.py. A medium-scale stand-in for that dataset when
# you want real volume without a 30-60 minute live export.
# =============================================================================

# =============================================================================
# EDGE CASES — a small, hand-composed SYNTHETIC dataset for testing connector
# resilience, NOT volume. Every uid is prefixed "edge" so results are easy to
# find afterward. This does not modify the connector — it is test input only.
#
# Column syntax mirrors the load-test dataset's already-proven headers
# (docs/features/sap-smartedit/scripts/generate-loadtest-impex.py) exactly, so
# any failure here is attributable to the SPECIFIC edge case, not to some
# unrelated/unproven ImpEx construct.
#
# Companion images/ folder (same directory as this file) ships the 4 binary
# files the Media edge cases below reference — see each Media row's comment.
# =============================================================================

$catalogId = myContentCatalog
$contentCV = catalogVersion(CatalogVersion.catalog(Catalog.id[default=$catalogId]),CatalogVersion.version[default=Online])[default=$catalogId:Online]

# ---- PageTemplate: one normal baseline row, used as a legitimate reference target
INSERT_UPDATE PageTemplate; uid[unique=true]; name; active
                           ; edgeTemplateNormal; "Edge Normal Template"; true

# ---- Media case 1: two DIFFERENT codes sharing the SAME realfilename
#      (real SAP catalogs legitimately reuse one binary across several codes;
#      confirms the connector doesn't crash/misattribute when this happens).
#      Backing file: images/edge-shared.png
INSERT_UPDATE Media; code[unique=true]; mime; realfilename
                    ; edgeMediaSharedA; image/png; edge-shared.png
                    ; edgeMediaSharedB; image/png; edge-shared.png

# ---- Media case 2: unusual/mismatched mime type for its extension
#      (byte content is a placeholder — this tests the mime/extension-allowlist
#      code path, not actual video decoding). Backing file: images/edge-video.mp4
INSERT_UPDATE Media; code[unique=true]; mime; realfilename
                    ; edgeMediaUnusualMime; video/mp4; edge-video.mp4

# ---- Media case 3: mismatched mime/extension the other direction (PDF)
#      Backing file: images/edge-doc.pdf
INSERT_UPDATE Media; code[unique=true]; mime; realfilename
                    ; edgeMediaPdf; application/pdf; edge-doc.pdf

# ---- Media case 4: declared via the real SAP "@media" platform-resource
#      column instead of a bare realfilename/URL — the untested third path in
#      resolveLocalMedia. realfilename is ALSO given so the file is guaranteed
#      findable by basename regardless of how the @media path text resolves.
#      Backing file: images/edge-platform.png
INSERT_UPDATE Media; code[unique=true]; mime; @media[translator=de.hybris.platform.impex.jalo.media.MediaDataTranslator]; realfilename
                    ; edgeMediaPlatformResource; image/png; /electronicsContentCatalog/import/images/edge-platform.png; edge-platform.png

# ---- Foreign/unsupported type: NOT one of the 13 connector-supported types,
#      not in content_mapper. Used below purely as a reference TARGET, to test
#      "the target row exists, but its type isn't a mapped content type" —
#      distinct from a genuinely dangling reference to a uid that doesn't
#      exist at all.
INSERT_UPDATE ProductReference; code[unique=true]; name
                               ; edgeForeignProduct001; "Edge Foreign Product (unsupported type)"

# ---- ContentPage cases -------------------------------------------------------
# en/de/fr/es columns match the load-test's proven header exactly.
INSERT_UPDATE ContentPage; uid[unique=true]; name; title[lang=en]; title[lang=de]; title[lang=fr]; title[lang=es]; masterTemplate(uid,$contentCV); label; defaultPage; approvalStatus(code)
                          ; edgePageDangling; "Edge Dangling Reference"; "Edge Dangling Reference"; ; ; ; edgeTemplateGhost9999; edge-dangling; false; approved
                          ; edgePageUnicodeEmoji; "مرحبا 👋 Café — 日本語テスト"; "مرحبا 👋 Café — 日本語テスト"; ; ; ; edgeTemplateNormal; edge-unicode; false; approved
                          ; edgePageBlankPrimary; "Edge Blank Primary"; ; "Deutscher Titel vorhanden"; ; ; edgeTemplateNormal; edge-blank-primary; false; approved
                          ; edgeSharedUidAcrossTypes; "Edge Shared Uid (Page)"; "Edge Shared Uid (Page)"; ; ; ; edgeTemplateNormal; edge-shared-uid; false; approved
                          ; ; "Edge No Identity (blank uid)"; "Edge No Identity (blank uid)"; ; ; ; edgeTemplateNormal; edge-no-identity; false; approved
                          ; edgePageLongContent; "Edge Long Content Host"; "Edge Long Content Host"; ; ; ; edgeTemplateNormal; edge-long-content; false; approved

# Mixed-cased [lang=EN] header (uppercase) — same locale as the lowercase
# [lang=en] used everywhere else, in its OWN block so it doesn't collide with
# the header above.
INSERT_UPDATE ContentPage; uid[unique=true]; name; title[lang=EN]; masterTemplate(uid,$contentCV); label; defaultPage; approvalStatus(code)
                          ; edgePageCaseLocale; "Edge Case Locale"; "Title Via Uppercase EN Header"; edgeTemplateNormal; edge-case-locale; false; approved

# A locale code with no Contentstack destination-locale mapping at all.
INSERT_UPDATE ContentPage; uid[unique=true]; name; title[lang=en]; title[lang=zz]; masterTemplate(uid,$contentCV); label; defaultPage; approvalStatus(code)
                          ; edgePageUnmappedLocale; "Edge Unmapped Locale"; "Edge Unmapped Locale"; "Zz-Language Value"; edgeTemplateNormal; edge-unmapped-locale; false; approved

# ---- CMSParagraphComponent: extremely long content value (~60KB of real
# repeated text, not random bytes) + the uid this page slot references.
INSERT_UPDATE CMSParagraphComponent; &componentRef; uid[unique=true]; name; content[lang=en]
                                    ; edgeParaLong; edgeParaLong; "Edge Long Paragraph"; "<h2>Edge Long Content</h2><p>This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a real, repeated English sentence used only to test whether the connector correctly carries very large field values through end to end. This is a