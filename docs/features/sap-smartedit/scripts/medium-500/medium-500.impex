# ---- CMSLinkComponent: reuses the SAME uid as edgeSharedUidAcrossTypes above
# (a ContentPage), deliberately colliding across two DIFFERENT source types.
INSERT_UPDATE CMSLinkComponent; &componentRef; uid[unique=true]; name; url; target(code)
                               ; edgeSharedUidAcrossTypes; edgeSharedUidAcrossTypes; "Edge Shared Uid (Link)"; /edge-shared-uid-link; sameWindow

# ---- CMSNavigationNode + CMSNavigationEntry: circular (A->B->A) and
# self-referencing (A->A) navigation, using the proven item(&componentRef)
# polymorphic-reference construct.
INSERT_UPDATE CMSNavigationNode; &componentRef; uid[unique=true]; title[lang=en]; title[lang=de]; title[lang=fr]; title[lang=es]; visible
                                ; edgeNavNodeA; edgeNavNodeA; "Edge Nav Node A"; ; ; ; true
                                ; edgeNavNodeB; edgeNavNodeB; "Edge Nav Node B"; ; ; ; true

INSERT_UPDATE CMSNavigationEntry; uid[unique=true]; navigationNode(uid,$contentCV); item(&componentRef)
                                 ; edgeNavEntryAtoB; edgeNavNodeA; edgeNavNodeB
                                 ; edgeNavEntryBtoA; edgeNavNodeB; edgeNavNodeA
                                 ; edgeNavEntrySelf; edgeNavNodeA; edgeNavNodeA

# ---- CMSImageComponent: references the Media edge cases above, plus one
# dangling reference to a Media code that was never declared anywhere.
INSERT_UPDATE CMSImageComponent; &componentRef; uid[unique=true]; name; media(code,$contentCV)
                                ; edgeImageSharedFile; edgeImageSharedFile; "Edge Image (shared file)"; edgeMediaSharedA
                                ; edgeImagePlatformResource; edgeImagePlatformResource; "Edge Image (@media source)"; edgeMediaPlatformResource
                                ; edgeImageDanglingMedia; edgeImageDanglingMedia; "Edge Image (dangling media)"; edgeMediaGhost9999

# ---- ContentSlot: zero rows for a DECLARED, connector-supported type is
# tested via ContentSlotForTemplate below instead (kept there so this slot can
# still reference the foreign-type row and the dangling ContentPage/nav wiring
# above, all in one place).
INSERT_UPDATE ContentSlot; uid[unique=true]; name; active; cmsComponents(uid,$contentCV)
                          ; edgeSlotDanglingRef; "Edge Slot (dangling component ref)"; true; edgeComponentGhost9999
                          ; edgeSlotForeignTypeRef; "Edge Slot (foreign/unsupported type ref)"; true; edgeForeignProduct001
                          ; edgeSlotNormal; "Edge Slot (normal, real refs)"; true; edgeParaLong,edgeImageSharedFile

# ---- ContentSlotForTemplate: header declared, ZERO data rows follow — tests
# a connector-supported type that is present in the export but genuinely empty.
INSERT_UPDATE ContentSlotForTemplate; uid[unique=true]; position[unique=true]; pageTemplate(uid,$contentCV)[unique=true]; contentSlot(uid,$contentCV); allowOverwrite

# ---- ContentSlotForPage: wires the normal slot to one real page, keeping the
# file structurally complete without needing full page-render coverage.
INSERT_UPDATE ContentSlotForPage; uid[unique=true]; position[unique=true]; page(uid,$contentCV); contentSlot(uid,$contentCV)
                                 ; body-edgePageUnicodeEmoji; Body; edgePageUnicodeEmoji; edgeSlotNormal

# ---- SAP $lang macro vs the project's real master locale ------------------
# Everything above this line was parsed under no $lang macro at all. From here
# on, the file declares its own internal working language as German — while
# the migration project itself should still be configured with master_locale
# = en-us (same as every other test in this file). This is a real, legitimate
# combination: SAP's internal working language and the destination stack's
# master locale are two independent settings. Before the fix, the master
# (en-us) entry would have silently shown the German text instead.
$lang = de
INSERT_UPDATE ContentPage; uid[unique=true]; name; title[lang=en]; title[lang=de]; masterTemplate(uid,$contentCV); label; defaultPage; approvalStatus(code)
                          ; edgeLangMismatchPage; "Edge Lang Mismatch Page"; "English Edge Title"; "Deutscher Edge Titel"; edgeTemplateNormal; edge-lang-mismatch; false; approved

# ---- Partial translation: title translated, content is not ----------------
# Tests that an untranslated field on an otherwise genuinely-translated row
# gets OMITTED from the secondary-locale entry, not filled in with the
# English default (which used to make it look translated when it wasn't).
INSERT_UPDATE CMSParagraphComponent; &componentRef; uid[unique=true]; name; title[lang=en]; title[lang=de]; content[lang=en]; content[lang=de]
                                    ; edgePartialTranslation; edgePartialTranslation; "Edge Partial Translation"; "English Partial Title"; "Deutscher Partial Titel"; "English Partial Content"; 


# =============================================================================
# FILLER — normal, non-edge-case rows for volume. $lang reverts to the file's
# own default (unset) from here on, same as everything before the edge cases'
# own "$lang = de" section above — parseImpex's macro table is keyed by macro
# name and this file never redeclares $lang after this point, but every filler
# row below carries fully explicit title/content[lang=xx] columns, so it does
# not depend on whatever $lang happened to be left set from the edge cases.
# =============================================================================

# ---- PageTemplate (5) ----
INSERT_UPDATE PageTemplate; $contentCV[unique=true]; uid[unique=true]; name; active
                   ;                        ; MediumPageLayout; "Medium Page Layout"; true
                   ;                        ; MediumDocsLayout; "Medium Docs Layout"; true
                   ;                        ; MediumBlogLayout; "Medium Blog Layout"; true
                   ;                        ; MediumSupportLayout; "Medium Support Layout"; true
                   ;                        ; MediumLandingLayout; "Medium Landing Layout"; true

# ---- Media (15) ----
INSERT_UPDATE Media; $contentCV[unique=true]; code[unique=true]; mime; realfilename
                   ;                        ; medMedia000; image/png; edge-shared.png
                   ;                        ; medMedia001; image/png; edge-platform.png
                   ;                        ; medMedia002; application/pdf; edge-doc.pdf
                   ;                        ; medMedia003; video/mp4; edge-video.mp4
                   ;                        ; medMedia004; image/png; edge-shared.png
                   ;                        ; medMedia005; image/png; edge-platform.png
                   ;                        ; medMedia006; application/pdf; edge-doc.pdf
                   ;                        ; medMedia007; video/mp4; edge-video.mp4
                   ;                        ; medMedia008; image/png; edge-shared.png
                   ;                        ; medMedia009; image/png; edge-platform.png
                   ;                        ; medMedia010; application/pdf; edge-doc.pdf
                   ;                        ; medMedia011; video/mp4; edge-video.mp4
                   ;                        ; medMedia012; image/png; edge-shared.png
                   ;                        ; medMedia013; image/png; edge-platform.png
                   ;                        ; medMedia014; application/pdf; edge-doc.pdf

