# ---- CMSParagraphComponent (90) ----
INSERT_UPDATE CMSParagraphComponent; $contentCV[unique=true]; &componentRef; uid[unique=true]; name; content[lang=en]; content[lang=de]; content[lang=fr]; content[lang=es]
                   ;                        ; medPara0000; medPara0000; "Medium Paragraph 0000: Infrastructure Monitoring"; "<h2>Infrastructure Monitoring</h2><p>Real-time visibility into every service, with alerting that pages a human before your customers notice.</p>"; "<h2>Infrastruktur-Überwachung</h2><p>Echtzeit-Einblick in jeden Dienst, mit Benachrichtigungen, bevor Ihre Kunden etwas merken.</p>"; "<h2>Surveillance de l'infrastructure</h2><p>Visibilité en temps réel sur chaque service, avec des alertes avant que vos clients ne le remarquent.</p>"; "<h2>Monitoreo de infraestructura</h2><p>Visibilidad en tiempo real de cada servicio, con alertas antes de que sus clientes lo noten.</p>"
                   ;                        ; medPara0001; medPara0001; "Medium Paragraph 0001: Automated Backups"; "<h2>Automated Backups</h2><p>Point-in-time recovery across every environment, retained for thirteen months by default.</p>"; "<h2>Automatische Backups</h2><p>Wiederherstellung zu jedem Zeitpunkt in jeder Umgebung, standardmäßig dreizehn Monate aufbewahrt.</p>"; "<h2>Sauvegardes automatisées</h2><p>Récupération à tout moment dans chaque environnement, conservée treize mois par défaut.</p>"; "<h2>Copias de seguridad automatizadas</h2><p>Recuperación en cualquier momento en cada entorno, retenida trece meses por defecto.</p>"
                   ;                        ; medPara0002; medPara0002; "Medium Paragraph 0002: Zero-Downtime Deploys"; "<h2>Zero-Downtime Deploys</h2><p>Rolling deploys with automatic health-check gating and instant rollback on failure.</p>"; "<h2>Ausfallfreie Bereitstellungen</h2><p>Rolling Deploys mit automatischer Gesundheitsprüfung und sofortigem Rollback bei Fehlern.</p>"; "<h2>Déploiements sans interruption</h2><p>Déploiements progressifs avec vérification automatique et retour en arrière instantané.</p>"; "<h2>Despliegues sin tiempo de inactividad</h2><p>Despliegues progresivos con verificación automática y reversión instantánea.</p>"
                   ;                        ; medPara0003; medPara0003; "Medium Paragraph 0003: Cost Optimization"; "<h2>Cost Optimization</h2><p>Right-sizing recommendations generated weekly from actual usage, not guesswork.</p>"; "<h2>Kostenoptimierung</h2><p>Wöchentlich aus dem tatsächlichen Verbrauch generierte Größenempfehlungen, kein Rätselraten.</p>"; "<h2>Optimisation des coûts</h2><p>Recommandations de dimensionnement générées chaque semaine à partir de l'usage réel, sans conjecture.</p>"; "<h2>Optimización de costos</h2><p>Recomendaciones de dimensionamiento generadas semanalmente a partir del uso real, sin conjeturas.</p>"
                   ;                        ; medPara0004; medPara0004; "Medium Paragraph 0004: Security Compliance"; "<h2>Security Compliance</h2><p>Encryption at rest and in transit, with quarterly third-party audits published to every customer.</p>"; "<h2>Sicherheits-Compliance</h2><p>Verschlüsselung im Ruhezustand und bei der Übertragung, mit vierteljährlichen externen Audits.</p>"; "<h2>Conformité de sécurité</h2><p>Chiffrement au repos et en transit, avec des audits tiers trimestriels.</p>"; "<h2>Cumplimiento de seguridad</h2><p>Cifrado en reposo y en tránsito, con auditorías externas trimestrales.</p>"
                   ;                        ; medPara0005; medPara0005; "Medium Paragraph 0005: API Rate Limiting"; "<h2>API Rate Limiting</h2><p>Per-token limits configurable per environment, with clear headers on every response.</p>"; "<h2>API-Ratenbegrenzung</h2><p>Pro Token konfigurierbare Limits für jede Umgebung, mit klaren Headern in jeder Antwort.</p>"; "<h2>Limitation du débit API</h2><p>Limites configurables par jeton et par environnement, avec des en-têtes clairs sur chaque réponse.</p>"; "<h2>Limitación de tasa de API</h2><p>Límites configurables por token y por entorno, con encabezados claros en cada respuesta.</p>"
                   ;                        ; medPara0006; medPara0006; "Medium Paragraph 0006: Multi-Region Failover"; "<h2>Multi-Region Failover</h2><p>Automatic traffic shifting when a region degrades, with no manual intervention required.</p>"; "<h2>Multi-Region-Failover</h2><p>Automatische Traffic-Umleitung bei Beeinträchtigung einer Region, ganz ohne manuellen Eingriff.</p>"; "<h2>Basculement multi-régions</h2><p>Redirection automatique du trafic lorsqu'une région se dégrade, sans intervention manuelle.</p>"; "<h2>Conmutación multirregional</h2><p>Redirección automática del tráfico cuando una región se degrada, sin intervención manual.</p>"
                   ;                        ; medPara0007; medPara0007; "Medium Paragraph 0007: Database Migrations"; "<h2>Database Migrations</h2><p>Versioned, reversible migrations run as a release step, never at container boot.</p>"; "<h2>Datenbankmigrationen</h2><p>Versionierte, umkehrbare Migrationen als Release-Schritt, niemals beim Container-Start.</p>"; "<h2>Migrations de base de données</h2><p>Migrations versionnées et réversibles exécutées comme étape de publication, jamais au démarrage du conteneur.</p>"; "<h2>Migraciones de base de datos</h2><p>Migraciones versionadas y reversibles ejecutadas como paso de publicación, nunca al iniciar el contenedor.</p>"
                   ;                        ; medPara0008; medPara0008; "Medium Paragraph 0008: Team Access Control"; "<h2>Team Access Control</h2><p>Role-based permissions down to the individual service, audited on every change.</p>"; "<h2>Team-Zugriffskontrolle</h2><p>Rollenbasierte Berechtigungen bis auf Service-Ebene, bei jeder Änderung protokolliert.</p>"; "<h2>Contrôle d'accès de l'équipe</h2><p>Permissions basées sur les rôles jusqu'au service individuel, auditées à chaque modification.</p>"; "<h2>Control de acceso del equipo</h2><p>Permisos basados en roles hasta el servicio individual, auditados en cada cambio.</p>"
                   ;                        ; medPara0009; medPara0009; "Medium Paragraph 0009: Billing Transparency"; "<h2>Billing Transparency</h2><p>Line-item invoices that map directly to services, with no bundled surprise fees.</p>"; "<h2>Transparente Abrechnung</h2><p>Rechnungen, die direkt auf Dienste abgebildet werden, ohne versteckte Zusatzkosten.</p>"; "<h2>Facturation transparente</h2><p>Des factures détaillées qui correspondent directement aux services, sans frais cachés.</p>"; "<h2>Facturación transparente</h2><p>Facturas detalladas que corresponden directamente a los servicios, sin cargos ocultos.</p>"
                   ;                        ; medPara0010; medPara0010; "Medium Paragraph 0010: Log Aggregation"; "<h2>Log Aggregation</h2><p>Centralized, searchable logs retained for ninety days across every service and environment.</p>"; "<h2>Log-Aggregation</h2><p>Zentralisierte, durchsuchbare Logs, neunzig Tage lang für jeden Dienst und jede Umgebung aufbewahrt.</p>"; "<h2>Agrégation des journaux</h2><p>Journaux centralisés et consultables, conservés quatre-vingt-dix jours pour chaque service et environnement.</p>"; "<h2>Agregación de registros</h2><p>Registros centralizados y buscables, conservados noventa días en cada servicio y entorno.</p>"
                   ;                        ; medPara0011; medPara0011; "Medium Paragraph 0011: Custom Domains"; "<h2>Custom Domains</h2><p>Automatic certificate issuance and renewal the moment a CNAME is verified.</p>"; "<h2>Benutzerdefinierte Domains</h2><p>Automatische Zertifikatsausstellung und -verlängerung, sobald ein CNAME verifiziert ist.</p>"; "<h2>Domaines personnalisés</h2><p>Émission et renouvellement automatiques des certificats dès qu'un CNAME est vérifié.</p>"; "<h2>Dominios personalizados</h2><p>Emisión y renovación automática de certificados en cuanto se verifica un CNAME.</p>"
                   ;                        ; medPara0012; medPara0012; "Medium Paragraph 0012: Private Networking"; "<h2>Private Networking</h2><p>Services in one project share a private network by default, with no extra configuration.</p>"; "<h2>Privates Netzwerk</h2><p>Dienste in einem Projekt teilen sich standardmäßig ein privates Netzwerk, ohne zusätzliche Konfiguration.</p>"; "<h2>Réseau privé</h2><p>Les services d'un même projet partagent un réseau privé par défaut, sans configuration supplémentaire.</p>"; "<h2>Red privada</h2><p>Los servicios de un mismo proyecto comparten una red privada por defecto, sin configuración adicional.</p>"
                   ;                        ; medPara0013; medPara0013; "Medium Paragraph 0013: Scheduled Jobs"; "<h2>Scheduled Jobs</h2><p>Cron-syntax scheduling in UTC, with automatic retry and dead-letter handling on failure.</p>"; "<h2>Geplante Jobs</h2><p>Cron-Syntax-Planung in UTC, mit automatischem Wiederholungsversuch und Dead-Letter-Behandlung bei Fehlern.</p>"; "<h2>Tâches planifiées</h2><p>Planification au format cron en UTC, avec nouvelle tentative automatique et gestion des messages en échec.</p>"; "<h2>Tareas programadas</h2><p>Programación con sintaxis cron en UTC, con reintento automático y gestión de mensajes fallidos.</p>"
                   ;                        ; medPara0014; medPara0014; "Medium Paragraph 0014: Incident Response"; "<h2>Incident Response</h2><p>A documented on-call rotation with a public status page hosted off-platform on purpose.</p>"; "<h2>Incident-Reaktion</h2><p>Eine dokumentierte Bereitschaftsrotation mit einer öffentlichen, bewusst extern gehosteten Statusseite.</p>"; "<h2>Réponse aux incidents</h2><p>Une rotation d'astreinte documentée, avec une page de statut publique hébergée volontairement hors plateforme.</p>"; "<h2>Respuesta a incidentes</h2><p>Una rotación de guardia documentada, con una página de estado pública alojada deliberadamente fuera de la plataforma.</p>"
                   ;                        ; medPara0015; medPara0015; "Medium Paragraph 0015: Infrastructure Monitoring"; "<h2>Infrastructure Monitoring</h2><p>Real-time visibility into every service, with alerting that pages a human before your customers notice.</p>"; "<h2>Infrastruktur-Überwachung</h2><p>Echtzeit-Einblick in jeden Dienst, mit Benachrichtigungen, bevor Ihre Kunden etwas merken.</p>"; "<h2>Surveillance de l'infrastructure</h2><p>Visibilité en temps réel sur chaque service, avec des alertes avant que vos clients ne le remarquent.</p>"; "<h2>Monitoreo de infraestructura</h2><p>Visibilidad en tiempo real de cada servicio, con alertas antes de que sus clientes lo noten.</p>"
                   ;                        ; medPara0016; medPara0016; "Medium Paragraph 0016: Automated Backups"; "<h2>Automated Backups</h2><p>Point-in-time recovery across every environment, retained for thirteen months by default.</p>"; "<h2>Automatische Backups</h2><p>Wiederherstellung zu jedem Zeitpunkt in jeder Umgebung, standardmäßig dreizehn Monate aufbewahrt.</p>"; "<h2>Sauvegardes automatisées</h2><p>Récupération à tout moment dans chaque environnement, conservée treize mois par défaut.</p>"; "<h2>Copias de seguridad automatizadas</h2><p>Recuperación en cualquier momento en cada entorno, retenida trece meses por defecto.</p>"
                   ;                        ; medPara0017; medPara0017; "Medium Paragraph 0017: Zero-Downtime Deploys"; "<h2>Zero-Downtime Deploys</h2><p>Rolling deploys with automatic health-check gating and instant rollback on failure.</p>"; "<h2>Ausfallfreie Bereitstellungen</h2><p>Rolling Deploys mit automatischer Gesundheitsprüfung und sofortigem Rollback bei Fehlern.</p>"; "<h2>Déploiements sans interruption</h2><p>Déploiements progressifs avec vérification automatique et retour en arrière instantané.</p>"; "<h2>Despliegues sin tiempo de inactividad</h2><p>Despliegues progresivos con verificación automática y reversión instantánea.</p>"
                   ;                        ; medPara0018; medPara0018; "Medium Paragraph 0018: Cost Optimization"; "<h2>Cost Optimization</h2><p>Right-sizing recommendations generated weekly from actual usage, not guesswork.</p>"; "<h2>Kostenoptimierung</h2><p>Wöchentlich aus dem tatsächlichen Verbrauch generierte Größenempfehlungen, kein Rätselraten.</p>"; "<h2>Optimisation des coûts</h2><p>Recommandations de dimensionnement générées chaque semaine à partir de l'usage réel, sans conjecture.</p>"; "<h2>Optimización de costos</h2><p>Recomendaciones de dimensionamiento generadas semanalmente a partir del uso real, sin conjeturas.</p>"
                   ;                        ; medPara0019; medPara0019; "Medium Paragraph 0019: Security Compliance"; "<h2>Security Compliance</h2><p>Encryption at rest and in transit, with quarterly third-party audits published to every customer.</p>"; "<h2>Sicherheits-Compliance</h2><p>Verschlüsselung im Ruhezustand und bei der Übertragung, mit vierteljährlichen externen Audits.</p>"; "<h2>Conformité de sécurité</h2><p>Chiffrement au repos et en transit, avec des audits tiers trimestriels.</p>"; "<h2>Cumplimiento de seguridad</h2><p>Cifrado en reposo y en tránsito, con auditorías externas trimestrales.</p>"
                   ;                        ; medPara0020; medPara0020; "Medium Paragraph 0020: API Rate Limiting"; "<h2>API Rate Limiting</h2><p>Per-token limits configurable per environment, with clear headers on every response.</p>"; "<h2>API-Ratenbegrenzung</h2><p>Pro Token konfigurierbare Limits für jede Umgebung, mit klaren Headern in jeder Antwort.</p>"; "<h2>Limitation du débit API</h2><p>Limites configurables par jeton et par environnement, avec des en-têtes clairs sur chaque réponse.</p>"; "<h2>Limitación de tasa de API</h2><p>Límites configurables por token y por entorno, con encabezados claros en cada respuesta.</p>"
                   ;                        ; medPara0021; medPara0021; "Medium Paragraph 0021: Multi-Region Failover"; "<h2>Multi-Region Failover</h2><p>Automatic traffic shifting when a region degrades, with no manual intervention required.</p>"; "<h2>Multi-Region-Failover</h2><p>Automatische Traffic-Umleitung bei Beeinträchtigung einer Region, ganz ohne manuellen Eingriff.</p>"; "<h2>Basculement multi-régions</h2><p>Redirection automatique du trafic lorsqu'une région se dégrade, sans intervention manuelle.</p>"; "<h2>Conmutación multirregional</h2><p>Redirección automática del tráfico cuando una región se degrada, sin intervención manual.</p>"
