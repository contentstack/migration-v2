# ============================================================================
# LARGE SAMPLE CMS CONTENT EXPORT for SAP SmartEdit
# ============================================================================
# GENERATED SAMPLE DATA - NOT FROM A REAL SYSTEM
# This file contains many example pages, slots, and components
# to simulate a substantial export (~several MB when expanded).
#
# Customize before any import attempt.
# ============================================================================

$contentCatalog=yourContentCatalog
$catalogVersion=catalogVersion(catalog(id[default=$contentCatalog]),version[default=Staged])[unique=true,default=$contentCatalog:Staged]
$lang=en

# ----------------------------------------------------------------------------
# PAGE TEMPLATES (usually already exist - shown for completeness)
# ----------------------------------------------------------------------------
INSERT_UPDATE PageTemplate;uid[unique=true];name;velocityTemplate;active;
;HomepageTemplate;Homepage Template;homepage.vm;true;
;ContentPageTemplate;Content Page Template;contentpage.vm;true;
;CategoryPageTemplate;Category Page Template;categorypage.vm;true;

# ----------------------------------------------------------------------------
# CONTENT SLOTS (common slots)
# ----------------------------------------------------------------------------
INSERT_UPDATE ContentSlot;$catalogVersion;uid[unique=true];name;active;
;HeaderSlot;Header Slot;true;
;FooterSlot;Footer Slot;true;
;MainContentSlot;Main Content Slot;true;
;HomepageHeroSlot;Homepage Hero Slot;true;
;LeftNavigationSlot;Left Navigation Slot;true;
;RightPromotionSlot;Right Promotion Slot;true;
;ProductDetailsSlot;Product Details Slot;true;

# Many more slots would exist in a real export...

# ----------------------------------------------------------------------------
# GENERATED BULK SAMPLE DATA - Hundreds of example pages and components
# This section is programmatically expanded to create volume.
# In a real export this would come from your actual Staged catalog content.
# ----------------------------------------------------------------------------

