APP_TOKEN_KEY=MIGRATION_V2
PORT=5001
MANIFEST_ENCRYPT_KEY=mig-tool-secret-key-2026
MANIFEST_ENCRYPT_SALT=mig-tool-salt-2026
# Encrypts the v3 destination management-token secret at rest in
# database-v3/projects.json. Deliberately separate from APP_TOKEN_KEY (which
# signs session JWTs) and from the MANIFEST_* pair above: different purposes mean
# different rotation lifetimes. Rotating this makes previously stored token
# secrets unreadable — the tokens themselves live on in Contentstack and must be
# deleted there.
V3_SECRET_ENCRYPT_KEY=mig-tool-v3-secret-key-2026
V3_SECRET_ENCRYPT_SALT=mig-tool-v3-secret-salt-2026