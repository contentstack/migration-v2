{"/Users/yash.shinde/Documents/Migration/Delta Mig/migration-v2/api/src/utils/entry-update-script.cjs":{"context":{"error":true},"data":"{\"entry\":{\"content_type_uid\":\"article\",\"cs_title\":\"The Journey to Become Pirate King\",\"title\":\"The Journey to Become Pirate King\",\"url\":\"/article/the-journey-to-become-pirate-king\",\"locale\":\"en-us\",\"slug\":\"journey-to-pirate-king\",\"body\":{\"type\":\"doc\",\"attrs\":{},\"uid\":\"doc12911002112076\",\"children\":[{\"type\":\"p\",\"attrs\":{},\"uid\":\"p11862858551849\",\"children\":[{\"text\":\"\"}]},{\"type\":\"p\",\"attrs\":{},\"uid\":\"p54988697699734\",\"children\":[{\"text\":\"Luffy begins his legendary journey across the Grand Line to become the Pirate King...\"}]}],\"_version\":1},\"featuredimage\":\"51unx0oR3PJkZP9ZGNBZwe\",\"author\":[{\"uid\":\"24nNzO3BlHghtPhxCBHacf\",\"_content_type_uid\":\"author\"}],\"relatedarticles\":[{\"uid\":\"5usiFrtUdQWH6RSItGBqJz\",\"_content_type_uid\":\"article\"}],\"ACL\":{},\"_version\":2,\"tags\":[],\"_in_progress\":false,\"publish_details\":[{\"environment\":\"1DEQCqwFTPjhvdcQPid2OL\",\"version\":1,\"locale\":\"en-us\"}]}}","error":"","errorCode":121,"errorMessage":"Entry update failed.","errors":{"featuredimage":["is not a valid upload."]},"status":422,"statusText":"Unprocessable Entity"},"level":"error","timestamp":"2026-04-06T06:13:24.830Z"}
{"/Users/yash.shinde/Documents/Migration/Delta Mig/migration-v2/api/src/utils/entry-update-script.cjs":{"context":{"error":true},"data":"{\"entry\":{\"content_type_uid\":\"four_square_recipe\",\"title\":\"apple-strudel\",\"url\":\"/apple-strudel\",\"content\":{\"meal_type\":\"apple-Desserts\",\"recipe_title\":\"Apple Strudel updated\",\"preparation\":{\"type\":\"doc\",\"uid\":\"775ca50629db4e36986c48ce9495dbe9\",\"attrs\":{},\"children\":[{\"type\":\"ol\",\"attrs\":{},\"uid\":\"5e05b4f3827046e4b27a8bb834aac619\",\"children\":[{\"type\":\"li\",\"attrs\":{},\"uid\":\"81c3694a4a1d419aa4f56d3dc41c8e05\",\"children\":[{\"text\":\"Mix flour, salt, egg and water to a soft dough and knead until it comes away from the table and hands.\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"8f3ca838d5734ccbae50d6a448bd0f82\",\"children\":[{\"text\":\"Form into a ball and allow to rest covered in oil for 30 minutes.\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"116e4a65e575400cb88f33ca094375b1\",\"children\":[{\"text\":\"Put the dough on a floured covered linen cloth and roll into a rectangular shape. Extend it on the back of your hands to a wafer thin layer. Heat the butter and add the breadcrumbs until they become golden brown.\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"670cd45f7a4243288da3fd86809dd6cb\",\"children\":[{\"text\":\"Mix sugar with cinnamon. Mix raisins, lemon juice, apples and rum. Combine butter breadcrumbs and sugar mixture to create filling.\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"2720aeecc5ae412abaabf6feb76e7679\",\"children\":[{\"text\":\"Place filling in the extended layer of dough, cut off the thick ends and roll carefully with the cloth. Place the strudel on a buttered baking tray and bake at 190°C (170°C fan-forced) or until the pastry takes on a golden shine (30 – 40 minutes).\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"e3f7bab7cbab45cea11d58ef086bde68\",\"children\":[{\"text\":\"Coat with melted butter as soon as the strudel comes out of the oven.\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"d9056db098fc463098883a16845bbbe9\",\"children\":[{\"text\":\"Serve with cream or vanilla icecream.\"}]}]}]},\"introduction\":{\"type\":\"doc\",\"uid\":\"80a0de306d624257bd8af55793f88e37\",\"attrs\":{},\"children\":[{\"type\":\"p\",\"attrs\":{},\"uid\":\"b2dd09d79add42658b512f6aebdf36d7\",\"children\":[{\"text\":\"This delicious Apple Strudel is a great idea for your next dessert!\"}]}]},\"recipe_image\":\"5ef6ae7616ca40a388db24ba59995fd6\",\"preparation_time\":\"30 - 60 mins\",\"serves\":\"5 - 6\",\"recipe_page_link\":{\"title\":\"{230793E0-FD24-4326-B705-8BAEC13EB69B}\",\"href\":\"\"},\"author\":\"Yash\",\"body_text\":{\"type\":\"doc\",\"uid\":\"4c157e24d62f4336aefcf16d9570d9c4\",\"attrs\":{},\"children\":[{\"type\":\"p\",\"attrs\":{},\"uid\":\"17676b1284944a58872b3eed061848df\",\"children\":[{\"text\":\" \"}]}]},\"cooking_time\":\"30 - 60 mins\",\"ingredients\":{\"type\":\"doc\",\"uid\":\"1f3bf9929f044c06b1edb0a0dd8eb907\",\"attrs\":{},\"children\":[{\"type\":\"ul\",\"attrs\":{},\"uid\":\"8bd6477ec931430f8be147e1edf42bc1\",\"children\":[{\"type\":\"li\",\"attrs\":{},\"uid\":\"f88f981463d340338543994005c40446\",\"children\":[{\"text\":\"250g Pams Plain Flour\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"3bb35bfa92474d98a61bb045d94a2fa5\",\"children\":[{\"text\":\"1/2 tsp Pams Salt\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"973cb017a41d41878a73569896daba54\",\"children\":[{\"text\":\"1 egg\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"3ae271fa40e549699b20a08005d2fc31\",\"children\":[{\"text\":\"100ml lukewarm water\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"69697ab0ad7f4c23abc5ede9cd57eee1\",\"children\":[{\"text\":\"1 tbsp Pams Canola oil\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"e3da0b17c87444169c6590b713e6e8fb\",\"children\":[{\"text\":\"50g Pams Butter\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"746141b9919a4598adfa4cc957014c76\",\"children\":[{\"text\":\"100g Pams Fine Breadcrumbs\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"1236f84584aa403bb5c70634dd86b2b3\",\"children\":[{\"text\":\"140g sugar\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"3449a7a785734897a5ab7cdbf9f87fb5\",\"children\":[{\"text\":\"2 tsp cinnamon\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"2654abf909614a82a192296d7b5597c5\",\"children\":[{\"text\":\"170g Pams Raisins\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"8b73409957814aa0aa9128be17b75368\",\"children\":[{\"text\":\"1 dessert spoon lemon juice\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"7a6d7b0e915841e0b34a15d778d5aec0\",\"children\":[{\"text\":\"1.1kg peeled Granny Smith apples, cored and sliced\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"3a86ec9b17824652bcbc6525179b2fec\",\"children\":[{\"text\":\"A shot of rum (optional)\"}]},{\"type\":\"li\",\"attrs\":{},\"uid\":\"5fda478736714479b5a6da5d19f2869f\",\"children\":[{\"text\":\"Extra butter, melted\"}]}]}]}},\"locale\":\"en-us\",\"ACL\":{},\"_version\":2,\"tags\":[],\"_in_progress\":false,\"publish_details\":[]}}","error":"","errorCode":121,"errorMessage":"Entry update failed.","errors":{"content.recipe_image":["is not a valid upload."]},"status":422,"statusText":"Unprocessable Entity"},"level":"error","timestamp":"2026-04-06T09:13:23.735Z"}
